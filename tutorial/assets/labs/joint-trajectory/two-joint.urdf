<?xml version="1.0"?>
<robot name="ece_two_joint_trainer">
  <link name="base_link"/>
  <link name="upper_link"/>
  <link name="forearm_link"/>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="upper_link"/>
    <origin xyz="0 0 0.06"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9" upper="2.9" effort="2" velocity="1.0472"/>
  </joint>
  <joint name="joint_2" type="revolute">
    <parent link="upper_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.15 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9" upper="2.9" effort="2" velocity="1.5708"/>
  </joint>

  <ros2_control name="TwoAxisMock" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="disable_commands">false</param>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </ros2_control>
</robot>
